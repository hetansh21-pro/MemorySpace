{
  "system_name": "MemorySpace",
  "version": "1.0.0",
  "check_interval_seconds": 3,
  "notification_cooldown_seconds": 90,
  "thresholds": {
    "warning_percent": 80.0,
    "optimize_percent": 88.0,
    "critical_percent": 94.0,
    "psi_pressure_threshold": 35.0
  },
  "protected_apps": [
    "antigravity",
    "brave",
    "chrome",
    "chromium",
    "firefox",
    "code",
    "cursor",
    "studio.sh",
    "android-studio",
    "java",
    "gradle",
    "node",
    "python3",
    "bash",
    "zsh",
    "ptyxis",
    "gnome-terminal",
    "alacritty"
  ],
  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 7890
  }
}
